    "lint": "eslint components/beliq",
    "lint:fix": "eslint components/beliq --fix",
    "scrub:check": "bash scripts/scrub-check.sh"
  },
  "devDependencies": {
    "@beliq/sdk": "^0.4.0",
    "@eslint/js": "^10.0.1",
    "@pipedream/eslint-plugin-pipedream": "^0.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vitest": "^4.0.0"
  }
}
