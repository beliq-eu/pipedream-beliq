{
  "name": "pipedream-beliq",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "beliq connector for Pipedream: generate, validate, parse, and convert EU e-invoices. Source of truth for the components/beliq registry component.",
  "scripts": {
    "test": "vitest run --exclude test/integration.test.mjs",
    "test:watch": "vitest",
